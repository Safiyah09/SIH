modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Heritage API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Heritage Games"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Heritage API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd games/Karnataka-Heritage-Games && PORT=8000 pnpm --filter @workspace/api-server dev"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Heritage Games"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd games/Karnataka-Heritage-Games && PORT=5173 BASE_PATH=/games pnpm --filter @workspace/heritage-games dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22496
externalPort = 3000
